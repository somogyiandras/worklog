cabal-version:      3.12
name:               worklog
version:            0.2.1.0
synopsis:           Simple workfile management application
description:        Manages work files. Creates summary, filter, change attributes and run the application which handles the workfiles. Use simple project framework with additional files related to the workfile.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Somogyi András
maintainer:         somogyiandras74@gmail.com
-- copyright:
category:           work managment
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:
source-repository head
  type:     git
  location: git//github.com/somogyiandras/worklog.git

common common-settings
    ghc-options:      -Wall
    default-language: GHC2021

library
    import:           common-settings
    exposed-modules:  
                      Worklog.Case
                    , Worklog.CaseAnalysis
                    , Worklog.Todo
    -- other-modules:
    -- other-extensions:
    build-depends:    base >=4.16 && < 4.22
                    , time < 1.16.0.1
                    , containers < 0.8
                    , worklog
    hs-source-dirs:   src

library implementation-internal
    import:           common-settings
    exposed-modules:
                      Worklog.Implementation.Internal
    hs-source-dirs:   src-internal
    build-depends:    base >=4.16 && < 4.22

executable worklog
    import:           common-settings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
                      base >=4.16 && < 4.22
                    , worklog
                    , time < 1.16
    hs-source-dirs:   app

test-suite worklog-test
    import:           common-settings
    default-language: GHC2021
    other-modules:
                      Worklog.CaseSpec
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
                      base >=4.16 && < 4.22
                    , worklog
                    , tasty
                    , tasty-hunit
                    , time < 1.16
